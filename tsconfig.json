{
    "compilerOptions": {
        "target": "es2021",
        "lib": [
            "dom",
            "es2021",
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "esnext",
        "moduleResolution": "node",
        "noImplicitThis": false,
        "resolveJsonModule": true,
        "sourceMap": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "typeRoots": [
            "./types",
            "node_modules/@types",
            "node_modules/@testing-library"
        ],
        "baseUrl": "src",
        "paths": {
            "@src/*": ["*"]
        }
    },
    "include": [
        "src", "eslint-rules", "types",
    ],
    "exclude": [
        "node_modules",
        "dist",
        "*.js"
    ]
}
